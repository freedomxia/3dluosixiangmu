# OpenAI 兼容的 Chat Completions 接口。
# 可填写到 /v1，也可直接填写完整的 /chat/completions 地址。
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace-with-your-api-key
MODEL_NAME=replace-with-your-vision-model

# 固定图2人工建模风格参考图。本地运行与 Docker 均可使用该相对路径。
STYLE_REFERENCE_PATH=./config/style-reference.png

# 模型与任务参数
MODEL_TIMEOUT_SECONDS=600
MODEL_MAX_TOKENS=12000
MAX_UPLOAD_MB=15
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_CONCURRENT_JOBS=2
MAX_PENDING_JOBS=8
MAX_JOBS_PER_MINUTE=10
JOB_TTL_SECONDS=2592000
MAX_CLARIFICATION_ROUNDS=2
REPAIR_ATTEMPTS=2

# 独立语义审查会用新的视觉模型调用复查提示词，不信任草稿自报的 PASS。
# Pix 生图完成后，结果图需求符合度审查只标记通过/需修改，不会自动扣费重生。
SEMANTIC_AUDIT_ENABLED=true
POST_IMAGE_AUDIT_ENABLED=true

# 是否在提示词审查通过后调用 PixPark v3 生成结果图。
IMAGE_GENERATION_ENABLED=false
MAX_CONCURRENT_IMAGE_JOBS=1

# PixPark MCP。Token 只保存在服务器环境或私有运行目录中，不会被页面回显。
PIX_PARK_ENDPOINT=https://mcp.wedobest.com.cn/mcp/PixPark/http
PIX_PARK_TOKEN=

PIX_PARK_TIMEOUT_SECONDS=45
PIX_PARK_UPLOAD_TIMEOUT_SECONDS=90
PIX_PARK_DOWNLOAD_TIMEOUT_SECONDS=60
PIX_PARK_MAX_WAIT_SECONDS=240
PIX_PARK_POLL_INTERVAL_SECONDS=3
PIX_PARK_MAX_DOWNLOAD_MB=64

# Docker 对外端口
WEB_PORT=9985

# 页面保存的部署级配置目录。Docker 已固定为独立私有卷，本地通常无需修改。
# RUNTIME_DIR=./.runtime
